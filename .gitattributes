# Normalize line endings in the repo to LF; check out per-platform by default.
* text=auto

# Shell scripts must stay LF even on Windows checkouts, or they fail to run in
# Linux/Docker (a CRLF shebang yields "exec: bash\r: not found", exit 127).
*.sh text eol=lf
gradlew text eol=lf

# Windows-only scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
