<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Read suite connection config from the Dragonfly hub (BROKER.md Phase 1). Granted only
         because all suite apps share one signing key; harmless if Dragonfly isn't installed. -->
    <uses-permission android:name="com.dragonfly.permission.READ_SUITE_CONFIG" />

    <!-- Health Connect (com.spotter.health) — WRITE ONLY, opt-in behind a Settings toggle.
         Spotter mirrors finished workouts and weigh-ins into the user's system health record and
         never reads anything back, so no READ_* permission is declared. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- API 30+ package visibility: needed to resolve Dragonfly's ContentProvider, and (below
         Android 14, where Health Connect ships as a separate APK) to see the Health Connect
         provider at all — without it HealthConnectClient.getSdkStatus always reports UNAVAILABLE. -->
    <queries>
        <package android:name="com.dragonfly" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".SpotterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Spotter"
        android:usesCleartextTraffic="true">
        <!-- WorkManager is initialized on-demand via SpotterApp's Configuration.Provider (so
             @HiltWorker workers get their injected deps); remove the default startup initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Spotter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static launcher shortcuts (long-press the app icon): Start workout / Log weight /
                 Coach. Each fires a spotter://shortcut/<target> VIEW intent handled in code. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Health Connect privacy-policy rationale, pre-Android 14 (the standalone Health
                 Connect APK). Deliberately wired to MainActivity rather than a dedicated screen:
                 Spotter's Health Connect use is one opt-in toggle in Settings that explains itself,
                 so landing the user in the app is the honest minimum. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- The same rationale entry point on Android 14+, where Health Connect is part of the
             platform and uses the permission-usage intent instead. Same target, same reasoning. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Shares the downloaded data exports (cacheDir/exports/) with the Android share sheet.
             See com.spotter.data.export.ExportRepository + res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- AppAuth (BROKER.md Phase 2c) themes its AuthorizationManagementActivity as AppCompat but
             leaves RedirectUriReceiverActivity to inherit the app theme, which isn't AppCompat →
             it crashes on the redirect ("You need to use a Theme.AppCompat theme"). Force an
             AppCompat translucent theme on it (the same one AppAuth uses for its other activity). -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar"
            tools:node="merge" />

        <service
            android:name=".ui.cardio.CardioRunService"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="cardio_interval_timer" />
        </service>
        <service
            android:name=".ui.workout.WorkoutSessionService"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workout_session" />
        </service>

        <!-- Home-screen "today's workout" glance (next/today workout or live set progress),
             reads the last-known snapshot the app persists — no network of its own. -->
        <receiver
            android:name=".widget.SpotterWidgetReceiver"
            android:exported="true"
            android:label="Today's workout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spotter_widget_info" />
        </receiver>
    </application>
</manifest>
